# Copy to .env and fill in. Never commit the real .env.

DATABASE_URL=postgres://user:password@host:5432/lifesettle

# Signs the session cookie, which asserts a user id and role — anyone holding
# this string could forge an administrator. Required in production; the app
# refuses to start without it. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Encrypts the tax numbers investors give when they register. 32 bytes, as
# hex or base64. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If it is left blank the key is derived from SESSION_SECRET instead, which
# works but ties the two together — rotating SESSION_SECRET would then make
# every stored tax number unreadable. Set this one and rotate it separately.
TAXID_KEY=

# Seeds the first admin the first time the database is empty, then ignored.
# There is no default password: production will not start without one.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
ADMIN_NAME=

NODE_ENV=production
PORT=3000

# --- Database TLS -----------------------------------------------------------
# The certificate is verified by default. Supply your provider's CA one of two
# ways if verification fails:
#   PGSSLROOTCERT=/etc/ssl/certs/provider-ca.crt
#   PGSSLROOTCERT_PEM="-----BEGIN CERTIFICATE-----\n…"
# Or accept it unverified (encrypted, but not authenticated) — appropriate only
# for a private-network hop such as Render's internal database endpoint:
#   PGSSLMODE=no-verify
# PGSSL=true|false forces TLS on or off regardless of the host.

# ---------------------------------------------------------------------
# Policy Valuation
#
# The valuation model is a separate program on its own service. Set these
# and /valuation on this server becomes a door to it: an administrator
# signed in here reaches it without a second password, and it stops being
# reachable by anyone who merely knows its address.
#
# Leave VALUATION_URL unset and the menu entry simply says it is not
# configured — nothing else changes.
VALUATION_URL=https://policy-valuation-e953.onrender.com
# The basic-auth credentials that service asks for (its APP_USER and
# APP_PASSWORD). Held here so the browser never sees them.
VALUATION_USER=
VALUATION_PASSWORD=
