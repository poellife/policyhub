# Copy to .env.test (git-ignored) and fill in.
# These are accounts on a THROWAWAY test database. Never point them at
# production, and never reuse a real password here.

TEST_BASE=http://localhost:3000

TEST_ADMIN_EMAIL=admin@test.local
TEST_ADMIN_PASSWORD=

# Only needed by the manager and investor suites, which run against the
# fixture database built by scripts/make-sample-data.js.
TEST_MANAGER1_EMAIL=pm1@test.local
TEST_MANAGER1_PASSWORD=
TEST_MANAGER2_EMAIL=pm2@test.local
TEST_MANAGER2_PASSWORD=
TEST_INVESTOR1_EMAIL=investor1@test.local
TEST_INVESTOR1_PASSWORD=
TEST_INVESTOR2_EMAIL=investor2@test.local
TEST_INVESTOR2_PASSWORD=

# mail-test inspects the email outbox directly — point this at the same
# database the server under test is using.
TEST_DATABASE_URL=postgres://user:password@localhost:5432/lifesettle
